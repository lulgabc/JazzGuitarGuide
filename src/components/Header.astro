---
import { NAV, SITE } from "../lib/site";
import { stripBase, url } from "../lib/url";

const path = stripBase(Astro.url.pathname);

function isActive(href: string) {
  if (href === "/") return path === "/";
  const clean = href.replace(/\/$/, "");
  return path === clean || path.startsWith(`${clean}/`);
}
---

<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href={url("/")} aria-label={`${SITE.title} 首页`}>
      <span class="brand-mark" aria-hidden="true">
        <svg viewBox="0 0 40 40" fill="none">
          <circle cx="20" cy="20" r="18" stroke="currentColor" stroke-width="1.1" opacity=".42" />
          <path d="M14.2 8.5c-3.7 3.6-3.7 7.2 0 10.8s3.7 7.2 0 10.8" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" />
          <path d="M25.8 8.5c3.7 3.6 3.7 7.2 0 10.8s-3.7 7.2 0 10.8" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" />
          <path d="M20 5.5v29" stroke="currentColor" stroke-width="0.9" opacity=".55" />
          <circle cx="20" cy="20" r="3.2" fill="currentColor" opacity=".92" />
        </svg>
      </span>
      <span class="brand-text">
        <span class="brand-name">Jazz Guitar Guide</span>
        <span class="brand-sub">爵士吉他学习手册</span>
      </span>
    </a>

    <nav class="main-nav" aria-label="主导航">
      {NAV.map((item) => (
        <a href={url(item.href)} aria-current={isActive(item.href) ? "page" : undefined}>
          {item.short ?? item.label}
        </a>
      ))}
    </nav>

    <div class="header-tools">
      <button class="icon-btn" id="theme-toggle" type="button" aria-label="切换明暗主题" title="切换明暗主题">
        <svg class="theme-icon theme-icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
          <circle cx="12" cy="12" r="4" />
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41" stroke-linecap="round" />
        </svg>
        <svg class="theme-icon theme-icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
          <path d="M20.5 14.2A8.5 8.5 0 0 1 9.8 3.5 8.5 8.5 0 1 0 20.5 14.2Z" stroke-linejoin="round" />
        </svg>
      </button>
      <button class="icon-btn mobile-toggle" id="mobile-toggle" type="button" aria-label="打开菜单" aria-controls="mobile-nav" aria-expanded="false">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </div>
</header>

<nav class="mobile-nav" id="mobile-nav" aria-label="移动端导航">
  {NAV.map((item) => (
    <a href={url(item.href)} aria-current={isActive(item.href) ? "page" : undefined}>
      <span>{item.label}</span>
      <span aria-hidden="true">→</span>
    </a>
  ))}
</nav>
