---
import { SITE } from "../lib/site";
import { UI, localeHome, type LocaleCode } from "../i18n/locales";
import { url } from "../lib/url";

interface Props {
  locale?: LocaleCode;
  mode?: "site" | "guide";
}

const { locale = "zh", mode = "site" } = Astro.props;
const ui = UI[locale];
const year = new Date().getFullYear();
const isGuide = mode === "guide";
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div class="footer-brand">
        <a class="brand" href={url(localeHome(locale))}>
          <span class="brand-mark" aria-hidden="true">
            <svg viewBox="0 0 40 40" fill="none">
              <circle cx="20" cy="20" r="18" stroke="currentColor" stroke-width="1.1" opacity=".42" />
              <path d="M14.2 8.5c-3.7 3.6-3.7 7.2 0 10.8s3.7 7.2 0 10.8" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" />
              <path d="M25.8 8.5c3.7 3.6 3.7 7.2 0 10.8s-3.7 7.2 0 10.8" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" />
              <path d="M20 5.5v29" stroke="currentColor" stroke-width="0.9" opacity=".55" />
              <circle cx="20" cy="20" r="3.2" fill="currentColor" opacity=".92" />
            </svg>
          </span>
          <span class="brand-text">
            <span class="brand-name">Jazz Guitar Guide</span>
            <span class="brand-sub">{ui.brandSub}</span>
          </span>
        </a>
        <p>{ui.footer.tagline}</p>
      </div>

      {isGuide ? (
        <>
          <div class="footer-col">
            <h3>{ui.footer.guide}</h3>
            <ul>
              <li><a href="#chapters">{ui.nav.chapters}</a></li>
              <li><a href="#roadmap">{ui.nav.roadmap}</a></li>
              <li><a href="#tunes">{ui.nav.tunes}</a></li>
              <li><a href="#courses">{ui.nav.courses}</a></li>
              <li><a href="#players">{ui.nav.players}</a></li>
            </ul>
          </div>
          <div class="footer-col">
            <h3>{ui.nav.books} &amp; {ui.nav.tools}</h3>
            <ul>
              <li><a href="#books">{ui.nav.books}</a></li>
              <li><a href="#tools">{ui.nav.tools}</a></li>
              <li><a href={url("/basics/")}>{ui.cta}</a></li>
              <li><a href={url("/about/")}>{ui.footer.about}</a></li>
            </ul>
          </div>
          <div class="footer-col">
            <h3>{ui.footer.project}</h3>
            <ul>
              <li><a href={SITE.repo} target="_blank" rel="noopener noreferrer">{ui.footer.github} ↗</a></li>
              <li><a href={`${SITE.repo}/issues`} target="_blank" rel="noopener noreferrer">{ui.footer.issues} ↗</a></li>
              <li><a href="#top">{ui.footer.backTop} ↑</a></li>
            </ul>
          </div>
        </>
      ) : (
        <>
          <div class="footer-col">
            <h3>学习</h3>
            <ul>
              <li><a href={url("/basics/")}>入门知识</a></li>
              <li><a href={url("/roadmap/")}>12 个月路线图</a></li>
              <li><a href={url("/standards/")}>必学曲目</a></li>
              <li><a href={url("/library/")}>练习乐谱库</a></li>
              <li><a href={url("/guitars/")}>选琴指南</a></li>
              <li><a href={url("/tools/")}>练习工具箱</a></li>
            </ul>
          </div>

          <div class="footer-col">
            <h3>资源</h3>
            <ul>
              <li><a href={url("/courses/")}>免费课程</a></li>
              <li><a href={url("/players/")}>吉他大师</a></li>
              <li><a href={url("/books/")}>教材书单</a></li>
              <li><a href={url("/basics/glossary/")}>术语 &amp; FAQ</a></li>
            </ul>
          </div>

          <div class="footer-col">
            <h3>项目</h3>
            <ul>
              <li><a href={SITE.repo} target="_blank" rel="noopener noreferrer">GitHub 仓库 ↗</a></li>
              <li><a href={`${SITE.repo}/issues`} target="_blank" rel="noopener noreferrer">纠错 / 建议 ↗</a></li>
              <li><a href={url("/about/")}>关于本站</a></li>
              <li><a href="#top">回到顶部 ↑</a></li>
            </ul>
          </div>
        </>
      )}
    </div>

    <div class="footer-bottom">
      <span>© {year} Jazz Guitar Guide{isGuide ? ` · ${ui.footer.deepNote}` : " · 个人学习项目，非商业用途"}</span>
      <span>
        {ui.footer.built} ·
        <a href={SITE.repo} target="_blank" rel="noopener noreferrer">{ui.footer.source}</a>
      </span>
    </div>
  </div>
</footer>
