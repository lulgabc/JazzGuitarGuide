---
const roots = [
  ["0", "C"],
  ["1", "D♭ / C♯"],
  ["2", "D"],
  ["3", "E♭ / D♯"],
  ["4", "E"],
  ["5", "F"],
  ["6", "G♭ / F♯"],
  ["7", "G"],
  ["8", "A♭ / G♯"],
  ["9", "A"],
  ["10", "B♭ / A♯"],
  ["11", "B"],
];

const scales = [
  ["major", "大调 / Ionian", "0,2,4,5,7,9,11"],
  ["dorian", "Dorian", "0,2,3,5,7,9,10"],
  ["phrygian", "Phrygian", "0,1,3,5,7,8,10"],
  ["lydian", "Lydian", "0,2,4,6,7,9,11"],
  ["mixolydian", "Mixolydian", "0,2,4,5,7,9,10"],
  ["aeolian", "Aeolian / 自然小调", "0,2,3,5,7,8,10"],
  ["locrian", "Locrian", "0,1,3,5,6,8,10"],
  ["harmonic-minor", "和声小调", "0,2,3,5,7,8,11"],
  ["melodic-minor", "旋律小调", "0,2,3,5,7,9,11"],
  ["altered", "Altered（旋律小调第 7 调式）", "0,1,3,4,6,8,10"],
  ["lydian-dominant", "Lydian Dominant", "0,2,4,6,7,9,10"],
  ["locrian-2", "Locrian ♯2", "0,2,3,5,6,8,10"],
  ["dim-wh", "减音阶 Whole–Half", "0,2,3,5,6,8,9,11"],
  ["dim-hw", "减音阶 Half–Whole", "0,1,3,4,6,7,9,10"],
  ["whole-tone", "全音音阶", "0,2,4,6,8,10"],
  ["major-pent", "大调五声", "0,2,4,7,9"],
  ["minor-pent", "小调五声", "0,3,5,7,10"],
  ["blues", "Blues Scale", "0,3,5,6,7,10"],
  ["bebop-dominant", "Bebop Dominant", "0,2,4,5,7,9,10,11"],
  ["bebop-major", "Bebop Major", "0,2,4,5,7,8,9,11"],
];

const chords = [
  ["maj7", "maj7", "0,4,7,11"],
  ["m7", "m7", "0,3,7,10"],
  ["7", "7", "0,4,7,10"],
  ["m7b5", "m7♭5", "0,3,6,10"],
  ["dim7", "dim7", "0,3,6,9"],
  ["mMaj7", "mMaj7", "0,3,7,11"],
  ["6", "6", "0,4,7,9"],
  ["69", "6/9", "0,4,7,9,14"],
  ["maj9", "maj9", "0,4,7,11,14"],
  ["m9", "m9", "0,3,7,10,14"],
  ["9", "9", "0,4,7,10,14"],
  ["13", "13", "0,4,7,10,14,21"],
  ["7b9", "7♭9", "0,4,7,10,13"],
  ["7s9", "7♯9", "0,4,7,10,15"],
  ["7s11", "7♯11", "0,4,7,10,18"],
  ["7alt", "7alt", "0,4,10,13,15,18,20"],
  ["sus4", "sus4", "0,5,7"],
  ["7sus4", "7sus4", "0,5,7,10"],
  ["add9", "add9", "0,4,7,14"],
];
---

<div class="tool-panel" id="panel-fretboard" role="tabpanel" aria-labelledby="tab-fretboard">
  <div class="tool-head">
    <div>
      <h2>指板探索器</h2>
      <p>选一个根音，看看音阶或和弦在指板上长什么样。点任意圆点可以听到声音。</p>
    </div>
    <span class="pill pill-accent">交互</span>
  </div>

  <div class="tool-controls">
    <div class="field">
      <label for="fb-root">根音</label>
      <select id="fb-root">
        {roots.map(([value, label]) => <option value={value}>{label}</option>)}
      </select>
    </div>

    <div class="field">
      <label for="fb-mode">模式</label>
      <select id="fb-mode">
        <option value="scale">音阶</option>
        <option value="chord">和弦</option>
      </select>
    </div>

    <div class="field" id="fb-scale-field">
      <label for="fb-scale">音阶</label>
      <select id="fb-scale">
        {scales.map(([value, label]) => <option value={value}>{label}</option>)}
      </select>
    </div>

    <div class="field" id="fb-chord-field" hidden>
      <label for="fb-chord">和弦</label>
      <select id="fb-chord">
        {chords.map(([value, label]) => <option value={value}>{label}</option>)}
      </select>
    </div>

    <label class="switch" for="fb-note-names">
      <input type="checkbox" id="fb-note-names" />
      显示音名（默认显示音级）
    </label>
  </div>

  <div class="fretboard-wrap">
    <svg id="fb-svg" viewBox="0 0 1060 340" role="img" aria-label="交互式吉他指板"></svg>
  </div>

  <div class="fretboard-legend">
    <span><i class="legend-dot root"></i> 根音</span>
    <span><i class="legend-dot"></i> 音阶音</span>
    <span><i class="legend-dot chord"></i> 和弦音</span>
    <span>点击圆点试听 · 标准调弦 E A D G B E</span>
  </div>

  <p class="small muted" id="fb-summary" style="margin-top: 12px;"></p>
</div>

<script>
  const NOTE_NAMES = ["C", "C♯", "D", "D♯", "E", "F", "F♯", "G", "G♯", "A", "A♯", "B"];
  const DEGREE_NAMES: Record<number, string> = {
    0: "1", 1: "♭2", 2: "2", 3: "♭3", 4: "3", 5: "4", 6: "♯4",
    7: "5", 8: "♭6", 9: "6", 10: "♭7", 11: "7", 12: "8", 13: "♭9",
    14: "9", 15: "♯9", 16: "3", 17: "11", 18: "♯11", 19: "5", 20: "♭13", 21: "13",
  };

  const SCALES: Record<string, number[]> = {
    major: [0, 2, 4, 5, 7, 9, 11],
    dorian: [0, 2, 3, 5, 7, 9, 10],
    phrygian: [0, 1, 3, 5, 7, 8, 10],
    lydian: [0, 2, 4, 6, 7, 9, 11],
    mixolydian: [0, 2, 4, 5, 7, 9, 10],
    aeolian: [0, 2, 3, 5, 7, 8, 10],
    locrian: [0, 1, 3, 5, 6, 8, 10],
    "harmonic-minor": [0, 2, 3, 5, 7, 8, 11],
    "melodic-minor": [0, 2, 3, 5, 7, 9, 11],
    altered: [0, 1, 3, 4, 6, 8, 10],
    "lydian-dominant": [0, 2, 4, 6, 7, 9, 10],
    "locrian-2": [0, 2, 3, 5, 6, 8, 10],
    "dim-wh": [0, 2, 3, 5, 6, 8, 9, 11],
    "dim-hw": [0, 1, 3, 4, 6, 7, 9, 10],
    "whole-tone": [0, 2, 4, 6, 8, 10],
    "major-pent": [0, 2, 4, 7, 9],
    "minor-pent": [0, 3, 5, 7, 10],
    blues: [0, 3, 5, 6, 7, 10],
    "bebop-dominant": [0, 2, 4, 5, 7, 9, 10, 11],
    "bebop-major": [0, 2, 4, 5, 7, 8, 9, 11],
  };

  const CHORDS: Record<string, number[]> = {
    maj7: [0, 4, 7, 11],
    m7: [0, 3, 7, 10],
    "7": [0, 4, 7, 10],
    m7b5: [0, 3, 6, 10],
    dim7: [0, 3, 6, 9],
    mMaj7: [0, 3, 7, 11],
    "6": [0, 4, 7, 9],
    "69": [0, 4, 7, 9, 14],
    maj9: [0, 4, 7, 11, 14],
    m9: [0, 3, 7, 10, 14],
    "9": [0, 4, 7, 10, 14],
    "13": [0, 4, 7, 10, 14, 21],
    "7b9": [0, 4, 7, 10, 13],
    "7s9": [0, 4, 7, 10, 15],
    "7s11": [0, 4, 7, 10, 18],
    "7alt": [0, 4, 10, 13, 15, 18, 20],
    sus4: [0, 5, 7],
    "7sus4": [0, 5, 7, 10],
    add9: [0, 4, 7, 14],
  };

  const strings = [
    { pc: 4, midi: 40, label: "E" },
    { pc: 9, midi: 45, label: "A" },
    { pc: 2, midi: 50, label: "D" },
    { pc: 7, midi: 55, label: "G" },
    { pc: 11, midi: 59, label: "B" },
    { pc: 4, midi: 64, label: "E" },
  ];

  const rootSel = document.getElementById("fb-root") as HTMLSelectElement;
  const modeSel = document.getElementById("fb-mode") as HTMLSelectElement;
  const scaleSel = document.getElementById("fb-scale") as HTMLSelectElement;
  const chordSel = document.getElementById("fb-chord") as HTMLSelectElement;
  const scaleField = document.getElementById("fb-scale-field") as HTMLElement;
  const chordField = document.getElementById("fb-chord-field") as HTMLElement;
  const noteNames = document.getElementById("fb-note-names") as HTMLInputElement;
  const svg = document.getElementById("fb-svg") as unknown as SVGSVGElement;
  const summary = document.getElementById("fb-summary") as HTMLElement;

  if (svg) {
    const NS = "http://www.w3.org/2000/svg";
    const LEFT = 66;
    const RIGHT = 24;
    const TOP = 34;
    const BOTTOM = 300;
    const FRETS = 15;
    const COLUMNS = 16;
    const WIDTH = 1060;
    const fretW = (WIDTH - LEFT - RIGHT) / COLUMNS;
    const spacing = (BOTTOM - TOP) / 5;

    let audioCtx: AudioContext | null = null;
    let master: GainNode | null = null;

    function ensureAudio() {
      if (!audioCtx) {
        const Ctx = window.AudioContext || (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext;
        audioCtx = new Ctx();
        master = audioCtx.createGain();
        master.gain.value = 0.16;
        master.connect(audioCtx.destination);
      }
      if (audioCtx.state === "suspended") void audioCtx.resume();
      return audioCtx;
    }

    function playMidi(midi: number) {
      const ctx = ensureAudio();
      if (!ctx || !master) return;
      const now = ctx.currentTime;
      const osc = ctx.createOscillator();
      const gain = ctx.createGain();
      osc.type = "triangle";
      osc.frequency.value = 440 * Math.pow(2, (midi - 69) / 12);
      gain.gain.setValueAtTime(0.0001, now);
      gain.gain.exponentialRampToValueAtTime(0.55, now + 0.012);
      gain.gain.exponentialRampToValueAtTime(0.0001, now + 0.55);
      osc.connect(gain).connect(master);
      osc.start(now);
      osc.stop(now + 0.6);
    }

    function el<K extends keyof SVGElementTagNameMap>(name: K, attrs: Record<string, string | number> = {}) {
      const node = document.createElementNS(NS, name);
      for (const [key, value] of Object.entries(attrs)) node.setAttribute(key, String(value));
      return node;
    }

    function render() {
      const root = Number(rootSel.value);
      const mode = modeSel.value;
      const intervals = mode === "chord" ? CHORDS[chordSel.value] : SCALES[scaleSel.value];
      const set = new Set(intervals.map((i) => (root + i) % 12));
      const isChord = mode === "chord";

      while (svg.firstChild) svg.removeChild(svg.firstChild);

      const board = el("rect", {
        x: LEFT,
        y: TOP - 24,
        width: WIDTH - LEFT - RIGHT,
        height: BOTTOM - TOP + 48,
        rx: 10,
        fill: "#17120d",
        stroke: "rgba(255,255,255,.09)",
      });
      svg.appendChild(board);

      // fret lines
      for (let f = 0; f <= FRETS; f++) {
        const x = LEFT + (f + 1) * fretW;
        const line = el("line", {
          x1: x, y1: TOP - 14, x2: x, y2: BOTTOM + 14,
          stroke: f === 0 ? "#d8c3a0" : "rgba(255,255,255,.16)",
          "stroke-width": f === 0 ? 4 : 1.2,
        });
        svg.appendChild(line);
      }

      // strings
      for (let i = 0; i < strings.length; i++) {
        const y = TOP + (5 - i) * spacing;
        const line = el("line", {
          x1: LEFT, y1: y, x2: WIDTH - RIGHT, y2: y,
          stroke: "rgba(232,220,198,.55)",
          "stroke-width": i === 0 ? 2.1 : 1.4,
        });
        svg.appendChild(line);

        const label = el("text", {
          x: 24, y: y + 4,
          fill: "rgba(232,220,198,.55)",
          "font-size": 12,
          "font-family": "ui-monospace, monospace",
        });
        label.textContent = strings[i].label;
        svg.appendChild(label);
      }

      // fret numbers
      [3, 5, 7, 9, 12, 15].forEach((f) => {
        const x = LEFT + (f + 0.5) * fretW;
        const text = el("text", {
          x, y: BOTTOM + 36,
          fill: "rgba(232,220,198,.42)",
          "font-size": 10,
          "text-anchor": "middle",
          "font-family": "ui-monospace, monospace",
        });
        text.textContent = String(f);
        svg.appendChild(text);
      });

      // position markers
      const centerY = (TOP + BOTTOM) / 2;
      [3, 5, 7, 9, 15].forEach((f) => {
        const x = LEFT + (f + 0.5) * fretW;
        svg.appendChild(el("circle", { cx: x, cy: centerY, r: 8, fill: "rgba(255,255,255,.045)" }));
      });
      [12].forEach((f) => {
        const x = LEFT + (f + 0.5) * fretW;
        svg.appendChild(el("circle", { cx: x, cy: centerY - spacing / 2, r: 7, fill: "rgba(255,255,255,.05)" }));
        svg.appendChild(el("circle", { cx: x, cy: centerY + spacing / 2, r: 7, fill: "rgba(255,255,255,.05)" }));
      });

      // notes
      let count = 0;
      for (let s = 0; s < strings.length; s++) {
        const y = TOP + (5 - s) * spacing;
        for (let f = 0; f <= FRETS; f++) {
          const pc = (strings[s].pc + f) % 12;
          if (!set.has(pc)) continue;
          count++;
          const midi = strings[s].midi + f;
          const interval = (pc - root + 12) % 12;
          const isRoot = interval === 0;
          const fill = isRoot ? "#c16450" : isChord ? "#79a48d" : "#d8a95c";
          const textColor = isRoot ? "#fff" : isChord ? "#06120c" : "#21180a";
          const label = noteNames.checked ? NOTE_NAMES[pc] : DEGREE_NAMES[interval] ?? String(interval);
          const x = LEFT + (f + 0.5) * fretW;

          const g = el("g", {
            class: "fretboard-note",
            "data-midi": midi,
            tabindex: 0,
            role: "button",
            "aria-label": `${strings[s].label} 弦 ${f} 品，${NOTE_NAMES[pc]}，音级 ${DEGREE_NAMES[interval] ?? interval}`,
          });
          const title = el("title");
          title.textContent = `${strings[s].label} 弦 ${f} 品 · ${NOTE_NAMES[pc]} · 音级 ${DEGREE_NAMES[interval] ?? interval}`;
          g.appendChild(title);
          g.appendChild(el("circle", { cx: x, cy: y, r: 15, fill, stroke: "rgba(0,0,0,.18)", "stroke-width": 1 }));
          const text = el("text", {
            x, y: y + 4,
            fill: textColor,
            "font-size": label.length > 2 ? 9 : 11,
            "font-weight": 700,
            "text-anchor": "middle",
            "font-family": "ui-monospace, monospace",
            "pointer-events": "none",
          });
          text.textContent = label;
          g.appendChild(text);
          svg.appendChild(g);
        }
      }

      const scaleName = mode === "chord" ? chordSel.options[chordSel.selectedIndex].text : scaleSel.options[scaleSel.selectedIndex].text;
      const rootName = rootSel.options[rootSel.selectedIndex].text;
      summary.textContent = `${rootName} ${scaleName} · 指板上共 ${count} 个可用音 · 建议先在一个把位内练习，再横向连接。`;
    }

    svg.addEventListener("click", (event) => {
      const target = (event.target as Element).closest(".fretboard-note") as SVGGElement | null;
      if (target) playMidi(Number(target.dataset.midi));
    });
    svg.addEventListener("keydown", (event) => {
      if (event.key !== "Enter" && event.key !== " ") return;
      const target = (event.target as Element).closest(".fretboard-note") as SVGGElement | null;
      if (target) {
        event.preventDefault();
        playMidi(Number(target.dataset.midi));
      }
    });

    modeSel.addEventListener("change", () => {
      const chord = modeSel.value === "chord";
      scaleField.hidden = chord;
      chordField.hidden = !chord;
      render();
    });
    [rootSel, scaleSel, chordSel].forEach((el) => el.addEventListener("change", render));
    noteNames.addEventListener("change", render);
    render();
  }
</script>
