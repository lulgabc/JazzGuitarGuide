---
import BaseLayout from "../layouts/BaseLayout.astro";
import SectionHead from "../components/SectionHead.astro";
import VideoCard from "../components/VideoCard.astro";
import { SITE } from "../lib/site";
import { url } from "../lib/url";
import { PHASES, ROUTINES } from "../data/roadmap";
import { FIRST_WAVE } from "../data/standards";
import { FEATURED_VIDEOS, CHANNELS } from "../data/courses";
import { FEATURED_PLAYERS } from "../data/players";
import { FEATURED_BOOKS } from "../data/books";
---

<BaseLayout description={SITE.description}>
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <span class="eyebrow hero-kicker">A field guide for the curious guitarist</span>
        <h1>
          <span class="line cn">把爵士吉他</span>
          <span class="line cn">拆成每天练的</span>
          <span class="line"><em>一小块。</em></span>
        </h1>
        <p class="hero-lead">
          一份写给自学者的中文爵士吉他地图：从第一声音色、2 &amp; 4 的摇摆，
          到 ii–V–I、标准曲、转录与上台。不堆资料，只告诉你今天该练什么。
        </p>
        <div class="btn-row">
          <a class="btn btn-primary" href={url("/roadmap/")}>从 12 个月路线图开始 <span aria-hidden="true">→</span></a>
          <a class="btn btn-ghost" href={url("/basics/")}>先看基础知识</a>
        </div>
        <div class="hero-meta">
          <span>零基础可入门</span>
          <span>40 首标准曲</span>
          <span>30+ 免费课程</span>
          <span>可交互练习</span>
        </div>
      </div>

      <div class="hero-visual" aria-hidden="true">
        <div class="record-wrap">
          <div class="record">
            <div class="record-label">
              <div>
                <strong>JAZZ<br />GUITAR</strong>
                <small>Study · Listen · Play</small>
              </div>
            </div>
            <div class="record-hole"></div>
          </div>
          <div class="tonearm">
            <div class="pivot"></div>
            <div class="arm"></div>
            <div class="head"></div>
          </div>
        </div>
        <div class="hero-float hero-float-a">
          <span class="chord">Dm7 → G7</span>
          <strong>ii–V–I</strong>
          所有标准曲的骨架
        </div>
        <div class="hero-float hero-float-b">
          <strong>Autumn Leaves</strong>
          G minor · 32 bars
        </div>
        <div class="hero-float hero-float-c">
          <strong>今日 30 分钟</strong>
          5 节奏 · 10 和弦 · 10 曲目 · 5 耳朵
        </div>
      </div>
    </div>

    <div class="container">
      <div class="hero-stats">
        <div class="hero-stat"><strong>11</strong><span>章基础知识</span></div>
        <div class="hero-stat"><strong>12</strong><span>个月学习路线</span></div>
        <div class="hero-stat"><strong>40</strong><span>首必学标准曲</span></div>
        <div class="hero-stat"><strong>30+</strong><span>精选免费课程</span></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHead
        kicker="The three pillars"
        title="先校准三件事，再谈即兴"
        description="爵士吉他不是“背完所有音阶再开始”。真正决定你像不像爵士的，是下面这三条主线。"
      />
      <div class="manifesto-grid">
        <article class="manifesto-card reveal">
          <div class="manifesto-num">01</div>
          <h3>节奏先于音阶</h3>
          <p>
            Swing 八分、2 &amp; 4、乐句的呼吸，比多背五个调式更重要。
            先用节拍器和唱片把时间感练出来，音阶才有地方落脚。
          </p>
        </article>
        <article class="manifesto-card reveal">
          <div class="manifesto-num">02</div>
          <h3>曲子是载体</h3>
          <p>
            一个概念只有在标准曲里用出来，才算真的学会。
            每学一个和声或句型，立刻把它放进一首正在练的曲子里。
          </p>
        </article>
        <article class="manifesto-card reveal">
          <div class="manifesto-num">03</div>
          <h3>耳朵决定上限</h3>
          <p>
            你能听出多少，就能弹出多少。听唱片、唱旋律、转录 solo，
            这些“慢功夫”会在某个时刻突然让你的 solo 变得有话说。
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHead
        kicker="The roadmap"
        title="12 个月，四个阶段"
        description="从“能弹完一首”到“能上台”。每个阶段都有明确目标、曲目、检查点和可勾选的练习清单。"
        link="/roadmap/"
        linkLabel="打开完整路线图"
      />
      <div class="grid grid-4">
        {PHASES.map((phase) => (
          <a class="card card-link phase-card reveal" href={url(`/roadmap/#${phase.id}`)}>
            <div class="phase-top">
              <span class="phase-num">{phase.number}</span>
              <span class="pill">{phase.duration.split(" / ")[0]}</span>
            </div>
            <h3>{phase.title}</h3>
            <p>{phase.subtitle}</p>
            <ul class="phase-list">
              {phase.focus.slice(0, 3).map((item) => <li>{item}</li>)}
            </ul>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHead
        kicker="First twelve"
        title="第一波：先拿下这 12 首"
        description="它们覆盖了 ii–V–I、blues、bossa、ballad 与 rhythm changes。先能 jam，再谈风格。"
        link="/standards/"
        linkLabel="查看全部 40 首"
      />
      <div class="grid grid-3">
        {FIRST_WAVE.slice(0, 6).map((tune) => (
          <a class="tune-card reveal" href={url(`/standards/#${tune.id}`)} style="text-decoration:none;color:inherit;">
            <div class="tune-top">
              <div>
                <h3>{tune.title}</h3>
                <div class="composer">{tune.composer}</div>
              </div>
              <span class="pill pill-sage">{tune.level}</span>
            </div>
            <div class="tune-facts">
              <span class="pill">{tune.key}</span>
              <span class="pill">{tune.form}</span>
            </div>
            <p class="tune-focus"><strong>练什么：</strong>{tune.focus.join(" · ")}</p>
          </a>
        ))}
      </div>
      <div class="btn-row" style="margin-top: 24px;">
        <a class="btn btn-ghost" href={url("/standards/")}>看完整曲目库与学习顺序 <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHead
        kicker="Free lessons"
        title="先看这三支，别急着收藏 100 个"
        description="从“整体顺序”“第一套和弦”“爵士 blues”三个入口开始。每支都值得反复看，而不是看一遍就过。"
        link="/courses/"
        linkLabel="浏览全部免费课程"
      />
      <div class="video-grid">
        {FEATURED_VIDEOS.slice(0, 3).map((video) => <VideoCard video={video} />)}
      </div>
      <div class="btn-row" style="margin-top: 24px;">
        <a class="btn btn-ghost" href={url("/courses/")}>还有 {CHANNELS.length} 个频道与 30+ 支单课 <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHead
        kicker="Listen deeper"
        title="听谁，决定你像谁"
        description="从 Django 到 Julian Lage，按年代与风格认识爵士吉他。每张推荐专辑都附上“听什么”。"
        link="/players/"
        linkLabel="进入大师名录"
      />
      <div class="player-grid">
        {FEATURED_PLAYERS.slice(0, 4).map((player) => (
          <a class="player-card" href={url(`/players/#${player.id}`)} style="text-decoration:none;color:inherit;">
            <span class="player-years">{player.years}</span>
            <span class="player-initial" aria-hidden="true">{player.name.charAt(0)}</span>
            <div class="player-role">{player.style}</div>
            <h3>{player.name}</h3>
            <p>{player.oneLiner}</p>
            <div class="player-albums"><span>先听：</span>{player.albums[0].title}</div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid grid-2" style="align-items: stretch;">
        <div class="card" style="display:flex;flex-direction:column;justify-content:center;">
          <span class="kicker">Practice toolbox</span>
          <h2 style="font-size: clamp(1.8rem, 3vw, 2.8rem); margin: 12px 0 12px;">今天就能用的练习工具</h2>
          <p style="max-width: 480px;">
            指板探索器、节拍器、ii–V–I 伴奏、练习计时器、听音测验。
            全部在浏览器里运行，不需要注册，也不会收集你的数据。
          </p>
          <div class="tag-row" style="margin: 18px 0 22px;">
            <span class="pill pill-accent">指板</span>
            <span class="pill pill-accent">节拍器</span>
            <span class="pill pill-accent">伴奏</span>
            <span class="pill pill-accent">计时器</span>
            <span class="pill pill-accent">练耳</span>
          </div>
          <div class="btn-row">
            <a class="btn btn-primary" href={url("/tools/")}>打开工具箱 <span aria-hidden="true">→</span></a>
          </div>
        </div>
        <div class="card" style="display:flex;flex-direction:column;justify-content:center;background:linear-gradient(145deg,var(--panel-2),var(--panel));">
          <div class="metro-bpm" style="font-size: clamp(3.2rem, 7vw, 5.4rem);">92<small>BPM</small></div>
          <div class="beat-dots" style="margin-bottom: 18px;">
            <span class="beat-dot is-accent is-on"></span>
            <span class="beat-dot"></span>
            <span class="beat-dot is-on"></span>
            <span class="beat-dot"></span>
          </div>
          <p class="small muted" style="margin-bottom: 16px;">2 &amp; 4 的重音，是爵士时间感的入口。</p>
          <div class="timer-segments" style="margin-bottom:0;">
            {ROUTINES[0].blocks.map((block) => (
              <div class="timer-segment"><span>{block.name}</span><span>{block.minutes} min</span></div>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <SectionHead
        kicker="The library"
        title="书不用多，读对顺序"
        description="方法书、和声、即兴、曲集、历史与心态。先选一本主线，其余当参考。"
        link="/books/"
        linkLabel="查看完整书单"
      />
      <div class="grid grid-3">
        {FEATURED_BOOKS.slice(0, 3).map((book) => (
          <a class="book-card" href={url(`/books/#${book.id}`)} style="text-decoration:none;color:inherit;">
            <div class="book-cover">{book.title.split(",")[0]}</div>
            <div>
              <h3>{book.title}</h3>
              <div class="book-author">{book.author}</div>
              <p>{book.why}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="card" style="padding: clamp(28px, 5vw, 56px); text-align:center; background: radial-gradient(circle at 50% 0%, var(--accent-soft), transparent 60%), var(--panel);">
        <span class="eyebrow" style="justify-content:center;">Start where you are</span>
        <h2 style="font-size: clamp(2rem, 4vw, 3.4rem); margin: 14px auto 14px; max-width: 760px;">
          今天不用练很多，<br />只要开始。
        </h2>
        <p class="lead" style="max-width: 600px; margin: 0 auto 24px;">
          选一首你喜欢的曲子，听三遍，唱一遍，然后在琴上找到第一个音。
          剩下的，路线图会带你走。
        </p>
        <div class="btn-row" style="justify-content:center;">
          <a class="btn btn-primary" href={url("/roadmap/")}>打开 12 个月路线图</a>
          <a class="btn btn-ghost" href={url("/tools/")}>先用工具箱练 15 分钟</a>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
